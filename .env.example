PORT=3001
MONGODB_URI=mongodb://localhost:27018/execution
INTERNAL_API_KEY=replace-with-long-random-secret

# Original /api routes accept the JWT issued by Service Orders.
AUTH_MODE=local
JWT_SECRET=replace-with-the-Service-Orders-JWT-secret
# For AUTH_MODE=gateway, share the gateway trust secret.
GATEWAY_TRUST_SECRET=

# Execution reads/completes orders over authenticated HTTP.
SERVICE_ORDERS_URL=http://host.docker.internal:3000
SERVICE_ORDERS_INTERNAL_API_KEY=replace-with-long-random-secret

# Shared broker connection; no other repository files or Docker network required.
# Local Docker: start Billing first; remote deployment: use the broker DNS name.
RABBITMQ_URL=amqp://oficina:replace-with-local-password@host.docker.internal:5672/oficina
EXECUTION_COMPLETION_TRANSPORT=rabbitmq

# Development fixtures run on Compose startup. Disable in production.
SEED_ENABLED=true

# Saga orchestrator (enable for new orders after deploying all participants).
SAGA_ENABLED=false
SAGA_STEP_TIMEOUT_MS=300000
SAGA_COMPENSATION_TIMEOUT_MS=1800000

# Local SonarQube (same server as Service Orders).
SONAR_TOKEN=
